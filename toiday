#!/data/data/com.termux/files/usr/bin/bash

# 1. Cấp quyền truy cập bộ nhớ & cài đặt Python
termux-setup-storage 2>/dev/null
pkg update -y && pkg install -y python

# 2. Đảm bảo thư mục Download tồn tại
mkdir -p /sdcard/Download

# 3. Tải sieuvip.py từ GitHub và lưu thành /sdcard/Download/Hachimi.py
echo "[*] Đang tải SieuVipPro về máy..."
curl -k -L "https://raw.githubusercontent.com/TenKoCo/SieuVip/refs/heads/main/sieuvip.py" -o /sdcard/Download/Hachimi.py

# 4. Kiểm tra nếu file tải về rỗng hoặc lỗi đường dẫn
if [ ! -s /sdcard/Download/Hachimi.py ]; then
    echo "[!] Tải thất bại. Vui lòng kiểm tra lại kết nối mạng hoặc file sieuvip.py trên repo!"
    return 1 2>/dev/null || exit 1
fi

echo "[+] Tải thành công vào /sdcard/Download/Hachimi.py"

# 5. Tạo shortcut 'sieuvip' để mở nhanh lần sau
cat << 'EOF' > /data/data/com.termux/files/usr/bin/sieuvip
#!/data/data/com.termux/files/usr/bin/bash
su -c "export PATH=$PATH:/data/data/com.termux/files/usr/bin && export TERM=xterm-256color && cd /sdcard/Download && python Hachimi.py"
EOF
chmod +x /data/data/com.termux/files/usr/bin/sieuvip

# 6. Kích hoạt tool bằng lệnh su
echo "[+] Khởi chạy tool..."
su -c "export PATH=$PATH:/data/data/com.termux/files/usr/bin && export TERM=xterm-256color && cd /sdcard/Download && python Hachimi.py"
