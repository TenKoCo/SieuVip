#!/data/data/com.termux/files/usr/bin/bash
# One-command bootstrap:
# . <(curl -fsSL RAW_URL/toiday)
_svr_setup_main() {
    local engine_url
    local expected_sha256
    local python_bin
    local su_bin
    local root_uid
    local cache_dir
    local engine_file
    local temporary_file
    local actual_sha256
    local config_file
    local cookie_store
    local legacy_cookie_file
    local step_status
    engine_url="${SIEUVIP_REJOIN_URL:-https://raw.githubusercontent.com/TenKoCo/sieuvip/refs/heads/main/sieuvip.py}"
    expected_sha256="${SIEUVIP_REJOIN_SHA256:-92a2f64714fe81a4baa4892792392f4c52539560d1322d7fa3f675edc174bcc2}"
    cache_dir="${XDG_DATA_HOME:-${HOME}/.local/share}/sieuvip-rejoin"
    engine_file="${cache_dir}/sieuvip.py"
    temporary_file="${engine_file}.download.$$"
    config_file="${HOME}/.config/sieuvip-rejoin/config.json"
    cookie_store="${HOME}/.config/sieuvip-rejoin/cookies.json"
    legacy_cookie_file="/sdcard/Download/cookie.txt"
    printf '\n%s\n' '========== SieuVip Rejoin · Termux =========='
    if ! command -v curl >/dev/null 2>&1; then
        printf '%s\n' '[!] Chưa có curl. Hãy chạy: pkg install curl' >&2
        return 127
    fi
    python_bin="$(command -v python 2>/dev/null || true)"
    if [ -z "${python_bin}" ]; then
        printf '%s\n' '[*] Đang cài Python...'
        if ! command -v pkg >/dev/null 2>&1 || ! pkg install -y python; then
            printf '%s\n' '[!] Không cài được Python.' >&2
            return 127
        fi
        python_bin="$(command -v python 2>/dev/null || true)"
    fi
    if [ -z "${python_bin}" ]; then
        printf '%s\n' '[!] Không tìm thấy Python sau khi cài.' >&2
        return 127
    fi
    su_bin="$(command -v su 2>/dev/null || true)"
    if [ -z "${su_bin}" ] && [ -x /system/bin/su ]; then
        su_bin="/system/bin/su"
    fi
    if [ -z "${su_bin}" ] && [ -x /system/xbin/su ]; then
        su_bin="/system/xbin/su"
    fi
    if [ -z "${su_bin}" ]; then
        printf '%s\n' '[!] Không tìm thấy su. Tool auto-login cookie cần máy root.' >&2
        return 1
    fi
    printf '%s\n' '[*] Đang yêu cầu quyền root...'
    root_uid="$("${su_bin}" -c '/system/bin/id -u' 2>/dev/null | tail -n 1)"
    if [ "${root_uid}" != "0" ]; then
        printf '%s\n' '[!] Root bị từ chối. Hãy cấp quyền Termux trong Magisk/KernelSU.' >&2
        return 1
    fi
    printf '%s\n' '[+] Root: OK'
    if ! mkdir -p "${cache_dir}"; then
        printf '%s\n' '[!] Không tạo được thư mục engine.' >&2
        return 1
    fi
    printf '%s\n' '[*] Đang tải engine mới nhất...'
    if ! curl -fsSL --retry 3 --connect-timeout 15 \
        "${engine_url}" -o "${temporary_file}"; then
        rm -f "${temporary_file}"
        printf '%s\n' '[!] Không tải được sieuvip.py.' >&2
        return 1
    fi
    if [ "${expected_sha256}" != "skip" ]; then
        if ! command -v sha256sum >/dev/null 2>&1; then
            printf '%s\n' '[*] Đang cài công cụ SHA-256...'
            if ! pkg install -y coreutils; then
                rm -f "${temporary_file}"
                printf '%s\n' '[!] Không cài được coreutils.' >&2
                return 1
            fi
        fi
        actual_sha256="$(sha256sum "${temporary_file}" | awk '{print $1}')"
        if [ "${actual_sha256}" != "${expected_sha256}" ]; then
            rm -f "${temporary_file}"
            printf '%s\n' '[!] SHA-256 không khớp; từ chối chạy file không đúng bản.' >&2
            return 1
