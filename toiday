#!/data/data/com.termux/files/usr/bin/bash
# Chạy bằng một lệnh:
# . <(curl "https://raw.githubusercontent.com/TenKoCo/SieuVip/refs/heads/main/toiday")

_svr_setup_main() {
    local engine_url
    local expected_sha256
    local python_bin
    local su_bin
    local root_uid
    local cache_dir
    local engine_file
    local temporary_file
    local actual_sha256
    local config_file
    local cookie_store
    local root_command

    engine_url="${SIEUVIP_REJOIN_URL:-https://raw.githubusercontent.com/TenKoCo/SieuVip/refs/heads/main/sieuvip.py}"
    expected_sha256="${SIEUVIP_REJOIN_SHA256:-26ca86e221f14a601a390c60098c864a8d398cd13c32c987e1445940c632a40b}"
    cache_dir="${XDG_DATA_HOME:-${HOME}/.local/share}/sieuvip-rejoin"
    engine_file="${cache_dir}/sieuvip.py"
    temporary_file="${engine_file}.download.$$"
    config_file="${HOME}/.config/sieuvip-rejoin/config.json"
    cookie_store="${HOME}/.config/sieuvip-rejoin/cookies.json"

    if ! command -v curl >/dev/null 2>&1; then
        printf '%s\n' '[!] Chưa có curl. Hãy chạy: pkg install curl' >&2
        return 127
    fi

    python_bin="$(command -v python 2>/dev/null || true)"
    if [ -z "${python_bin}" ]; then
        if ! command -v pkg >/dev/null 2>&1 || ! pkg install -y python >/dev/null 2>&1; then
            printf '%s\n' '[!] Không cài được Python.' >&2
            return 127
        fi
        python_bin="$(command -v python 2>/dev/null || true)"
    fi
    if [ -z "${python_bin}" ]; then
        printf '%s\n' '[!] Không tìm thấy Python sau khi cài.' >&2
        return 127
    fi

    su_bin="$(command -v su 2>/dev/null || true)"
    if [ -z "${su_bin}" ] && [ -x /system/bin/su ]; then
        su_bin="/system/bin/su"
    fi
    if [ -z "${su_bin}" ] && [ -x /system/xbin/su ]; then
        su_bin="/system/xbin/su"
    fi
    if [ -z "${su_bin}" ]; then
        printf '%s\n' '[!] Không tìm thấy su. Tool cần máy đã root.' >&2
        return 1
    fi
    root_uid="$("${su_bin}" -c '/system/bin/id -u' 2>/dev/null | tail -n 1)"
    if [ "${root_uid}" != "0" ]; then
        printf '%s\n' '[!] Không lấy được quyền root. Hãy cấp quyền Termux trong Magisk/KernelSU.' >&2
        return 1
    fi

    # Dùng root tự cấp quyền cơ bản; không gọi termux-setup-storage vì lệnh đó
    # có thể chờ câu hỏi y/n ẩn và làm loader trông như bị treo.
    "${su_bin}" -c "/system/bin/pm grant com.termux android.permission.READ_EXTERNAL_STORAGE >/dev/null 2>&1 || true; /system/bin/pm grant com.termux android.permission.WRITE_EXTERNAL_STORAGE >/dev/null 2>&1 || true; /system/bin/pm grant com.termux android.permission.POST_NOTIFICATIONS >/dev/null 2>&1 || true; /system/bin/appops set com.termux READ_EXTERNAL_STORAGE allow >/dev/null 2>&1 || true; /system/bin/appops set com.termux WRITE_EXTERNAL_STORAGE allow >/dev/null 2>&1 || true; /system/bin/appops set com.termux MANAGE_EXTERNAL_STORAGE allow >/dev/null 2>&1 || true; /system/bin/appops set com.termux LEGACY_STORAGE allow >/dev/null 2>&1 || true" >/dev/null 2>&1 || true

    if ! mkdir -p "${cache_dir}"; then
        printf '%s\n' '[!] Không tạo được thư mục engine.' >&2
        return 1
    fi
    if ! curl -fsSL --retry 3 --connect-timeout 15 \
        "${engine_url}" -o "${temporary_file}"; then
        rm -f "${temporary_file}"
        printf '%s\n' '[!] Không tải được sieuvip.py.' >&2
        return 1
    fi

    if [ "${expected_sha256}" != "skip" ]; then
        if ! command -v sha256sum >/dev/null 2>&1; then
            if ! pkg install -y coreutils >/dev/null 2>&1; then
                rm -f "${temporary_file}"
                printf '%s\n' '[!] Không cài được công cụ SHA-256.' >&2
                return 1
            fi
        fi
        actual_sha256="$(sha256sum "${temporary_file}" | awk '{print $1}')"
        if [ "${actual_sha256}" != "${expected_sha256}" ]; then
            rm -f "${temporary_file}"
            printf '%s\n' '[!] SHA-256 không khớp; từ chối chạy file không đúng bản.' >&2
            return 1
        fi
    fi

    if ! "${python_bin}" -c \
        'import ast,pathlib,sys; ast.parse(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))' \
        "${temporary_file}" >/dev/null 2>&1; then
        rm -f "${temporary_file}"
        printf '%s\n' '[!] Engine tải về không phải Python hợp lệ.' >&2
        return 1
    fi
    chmod 700 "${temporary_file}" || true
    if ! mv -f "${temporary_file}" "${engine_file}"; then
        rm -f "${temporary_file}"
        printf '%s\n' '[!] Không cài được engine.' >&2
        return 1
    fi

    root_command="export PATH='/data/data/com.termux/files/usr/bin:/system/bin:/system/xbin'; export HOME='${HOME}'; export TERM='xterm-256color'; cd '${HOME}'; exec '${python_bin}' '${engine_file}' --config '${config_file}' --cookies '${cookie_store}' --backend direct menu"
    "${su_bin}" -c "${root_command}"
}

_svr_setup_main "$@"
_svr_setup_status=$?
unset -f _svr_setup_main 2>/dev/null || true
return "${_svr_setup_status}" 2>/dev/null || exit "${_svr_setup_status}"
