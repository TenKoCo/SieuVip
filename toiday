        return 127
    fi
    python_bin="$(command -v python 2>/dev/null || true)"
    if [ -z "${python_bin}" ]; then
        printf '%s\n' '[*] Đang cài Python...'
        if ! command -v pkg >/dev/null 2>&1 || ! pkg install -y python; then
            printf '%s\n' '[!] Không cài được Python.' >&2
            return 127
        fi
        python_bin="$(command -v python 2>/dev/null || true)"
    fi
    if [ -z "${python_bin}" ]; then
        printf '%s\n' '[!] Không tìm thấy Python sau khi cài.' >&2
        return 127
    fi
    su_bin="$(command -v su 2>/dev/null || true)"
    if [ -z "${su_bin}" ] && [ -x /system/bin/su ]; then
        su_bin="/system/bin/su"
    fi
    if [ -z "${su_bin}" ] && [ -x /system/xbin/su ]; then
        su_bin="/system/xbin/su"
    fi
    if [ -z "${su_bin}" ]; then
        printf '%s\n' '[!] Không tìm thấy su. Tool auto-login cookie cần máy root.' >&2
        return 1
    fi
    printf '%s\n' '[*] Đang yêu cầu quyền root...'
    root_uid="$("${su_bin}" -c '/system/bin/id -u' 2>/dev/null | tail -n 1)"
    if [ "${root_uid}" != "0" ]; then
        printf '%s\n' '[!] Root bị từ chối. Hãy cấp quyền Termux trong Magisk/KernelSU.' >&2
        return 1
    fi
    printf '%s\n' '[+] Root: OK'
    if ! mkdir -p "${cache_dir}"; then
        printf '%s\n' '[!] Không tạo được thư mục engine.' >&2
        return 1
    fi
    printf '%s\n' '[*] Đang tải engine mới nhất...'
    if ! curl -fsSL --retry 3 --connect-timeout 15 \
        "${engine_url}" -o "${temporary_file}"; then
        rm -f "${temporary_file}"
        printf '%s\n' '[!] Không tải được sieuvip.py.' >&2
        return 1
    fi
    if [ "${expected_sha256}" != "skip" ]; then
        if ! command -v sha256sum >/dev/null 2>&1; then
            printf '%s\n' '[*] Đang cài công cụ SHA-256...'
            if ! pkg install -y coreutils; then
                rm -f "${temporary_file}"
                printf '%s\n' '[!] Không cài được coreutils.' >&2
                return 1
            fi
        fi
        actual_sha256="$(sha256sum "${temporary_file}" | awk '{print $1}')"
        if [ "${actual_sha256}" != "${expected_sha256}" ]; then
            rm -f "${temporary_file}"
            printf '%s\n' '[!] SHA-256 không khớp; từ chối chạy file không đúng bản.' >&2
            return 1
        fi
        printf '%s\n' '[+] SHA-256: OK'
    fi
    if ! "${python_bin}" -c \
        'import ast,pathlib,sys; ast.parse(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))' \
        "${temporary_file}"; then
        rm -f "${temporary_file}"
        printf '%s\n' '[!] Engine tải về không phải Python hợp lệ.' >&2
        return 1
    fi
    chmod 600 "${temporary_file}" || true
    if ! mv -f "${temporary_file}" "${engine_file}"; then
        rm -f "${temporary_file}"
        printf '%s\n' '[!] Không cài được engine.' >&2
        return 1
    fi
    printf '%s\n' '[+] Engine: sẵn sàng'
    # Nếu truyền tham số sau lệnh source, chuyển nguyên vẹn cho engine.
    if [ "$#" -gt 0 ]; then
        "${python_bin}" "${engine_file}" "$@"
        return $?
    fi
    # Lần đầu tự mở trình tạo config.
    if [ ! -f "${config_file}" ]; then
        printf '%s\n' '[*] Lần chạy đầu: tạo cấu hình...'
        "${python_bin}" "${engine_file}" \
            --config "${config_file}" \
            --cookies "${cookie_store}" \
            --backend su init
        step_status=$?
        if [ "${step_status}" -ne 0 ]; then
            return "${step_status}"
        fi
    fi
    # Tự import cookie.txt cũ nếu kho private chưa tồn tại.
    if [ -f "${legacy_cookie_file}" ] && [ ! -f "${cookie_store}" ]; then
        printf '%s\n' '[*] Phát hiện cookie.txt; đang import an toàn...'
        "${python_bin}" "${engine_file}" \
            --config "${config_file}" \
            --cookies "${cookie_store}" \
            import-cookies "${legacy_cookie_file}" || return $?
    fi
    printf '%s\n' '[*] Khởi động auto rejoin...'
    "${python_bin}" "${engine_file}" \
        --config "${config_file}" \
        --cookies "${cookie_store}" \
        --backend su run
}
_svr_setup_main "$@"
_svr_setup_status=$?
unset -f _svr_setup_main 2>/dev/null || true
return "${_svr_setup_status}" 2>/dev/null || exit "${_svr_setup_status}"
